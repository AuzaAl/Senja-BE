APP_NAME="Senja BE"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging-api.senja.sabirudigital.id

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --- Database (isi sesuai server staging) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=senja_be_staging
DB_USERNAME=
DB_PASSWORD=

# --- Session & cache (pakai redis/database pada staging) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Mail ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@senja.sabirudigital.id"
MAIL_FROM_NAME="${APP_NAME}"

# --- Passport clients (isi dari `php artisan passport:client`) ---
PASSPORT_PASSWORD_CLIENT_ID=
PASSPORT_PASSWORD_CLIENT_SECRET=

# --- Frontend origins (CORS) ---
FRONTEND_URL=https://staging.senja.sabirudigital.id
CMS_URL=https://staging-cms.senja.sabirudigital.id
CORS_ALLOWED_ORIGINS=https://staging.senja.sabirudigital.id,https://staging-cms.senja.sabirudigital.id

VITE_APP_NAME="${APP_NAME}"
