storage/*.key
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
public/storage
public/build
public/hot

# Tests & tooling — not needed at runtime
tests
phpunit.xml
pint.json
.editorconfig

# Editor / OS noise
.idea
.vscode
.DS_Store
Thumbs.db
*.log

# Docker meta
Dockerfile
docker-compose.yml
docker-compose.*.yml
.dockerignore
