APP_NAME="Senja BE"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.senja.sabirudigital.id

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (isi sesuai server produksi) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=senja_be_production
DB_USERNAME=
DB_PASSWORD=

# --- Session & cache (wajib redis/database pada produksi) ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.senja.sabirudigital.id

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (SMTP produksi) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@senja.sabirudigital.id"
MAIL_FROM_NAME="${APP_NAME}"

# --- Passport clients (isi dari `php artisan passport:client`) ---
PASSPORT_PASSWORD_CLIENT_ID=
PASSPORT_PASSWORD_CLIENT_SECRET=

# --- Frontend origins (CORS) ---
FRONTEND_URL=https://senja.sabirudigital.id
CMS_URL=https://cms.senja.sabirudigital.id
CORS_ALLOWED_ORIGINS=https://senja.sabirudigital.id,https://cms.senja.sabirudigital.id

VITE_APP_NAME="${APP_NAME}"
